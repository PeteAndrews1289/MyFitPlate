{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.js",
    "preflight:openai-models": "npm run build && node scripts/checkOpenAIModelAccess.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "eval:responses": "npm run build && node scripts/evaluateAIResponses.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "openai": "^6.46.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3"
  },
  "private": true
}
