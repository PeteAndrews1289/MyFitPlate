rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDoc(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function requestAuthorIsUser() {
      return request.resource.data.authorID == request.auth.uid ||
        request.resource.data.authorId == request.auth.uid;
    }

    function resourceAuthorIsUser() {
      return resource.data.authorID == request.auth.uid ||
        resource.data.authorId == request.auth.uid;
    }

    function requestCreatorIsUser() {
      return request.resource.data.creatorID == request.auth.uid ||
        request.resource.data.creatorId == request.auth.uid;
    }

    function resourceCreatorIsUser() {
      return resource.data.creatorID == request.auth.uid ||
        resource.data.creatorId == request.auth.uid;
    }

    function requestMembershipIsUser() {
      return request.resource.data.userID == request.auth.uid ||
        request.resource.data.userId == request.auth.uid;
    }

    function resourceMembershipIsUser() {
      return resource.data.userID == request.auth.uid ||
        resource.data.userId == request.auth.uid;
    }

    function requestMembershipGroupIsValid() {
      return (request.resource.data.groupID is string && request.resource.data.groupID.size() > 0) ||
        (request.resource.data.groupId is string && request.resource.data.groupId.size() > 0);
    }

    function validMembershipWrite() {
      return signedIn() &&
        request.resource.data.keys().hasOnly(["userID", "userId", "groupID", "groupId", "joinedAt"]) &&
        requestMembershipIsUser() &&
        requestMembershipGroupIsValid() &&
        (!request.resource.data.keys().hasAny(["joinedAt"]) || request.resource.data.joinedAt is timestamp);
    }

    function validPublishedBarcodeMacro(field) {
      return !resource.data.keys().hasAny([field]) ||
        (resource.data[field] is number &&
          resource.data[field] >= 0 &&
          resource.data[field] <= 1000);
    }

    function validBarcodeId(barcodeId) {
      return barcodeId is string &&
        barcodeId.matches('^[0-9]+$') &&
        (barcodeId.size() == 8 ||
          barcodeId.size() == 12 ||
          barcodeId.size() == 13 ||
          barcodeId.size() == 14);
    }

    function communityBarcodeReadsEnabled() {
      let configPath = /databases/$(database)/documents/internalConfig/communityBarcodeAggregation;
      return exists(configPath) &&
        get(configPath).data.publicReadsEnabled == true &&
        get(configPath).data.aggregationEnabled == true &&
        get(configPath).data.killSwitch == false;
    }

    function validPublishedBarcodeAggregate(barcodeId) {
      return
        validBarcodeId(barcodeId) &&
        resource.data.keys().hasOnly([
          "schemaVersion", "modelVersion", "status", "barcode", "name", "calories",
          "protein", "carbs", "fats", "fiber", "servingSize", "servingWeight",
          "contributorCount", "agreementCount", "conflictCount", "agreementRatio",
          "revision", "updatedAt"
        ]) &&
        resource.data.keys().hasAll([
          "schemaVersion", "modelVersion", "status", "barcode", "name", "calories",
          "protein", "carbs", "fats", "servingSize", "servingWeight",
          "contributorCount", "agreementCount", "conflictCount", "agreementRatio",
          "revision", "updatedAt"
        ]) &&
        resource.data.schemaVersion == 1 &&
        resource.data.modelVersion == "community_consensus_v1" &&
        resource.data.status == "published" &&
        resource.data.barcode == barcodeId &&
        resource.data.name is string &&
        resource.data.name.size() > 0 &&
        resource.data.name.size() <= 140 &&
        resource.data.calories is number &&
        resource.data.calories >= 0 &&
        resource.data.calories <= 5000 &&
        validPublishedBarcodeMacro("protein") &&
        validPublishedBarcodeMacro("carbs") &&
        validPublishedBarcodeMacro("fats") &&
        validPublishedBarcodeMacro("fiber") &&
        resource.data.servingSize is string &&
        resource.data.servingSize.size() > 0 &&
        resource.data.servingSize.size() <= 80 &&
        resource.data.servingWeight is number &&
        resource.data.servingWeight >= 10 &&
        resource.data.servingWeight <= 5000 &&
        resource.data.contributorCount is int &&
        resource.data.contributorCount >= 3 &&
        resource.data.contributorCount <= 250 &&
        resource.data.agreementCount is int &&
        resource.data.agreementCount >= 3 &&
        resource.data.agreementCount <= resource.data.contributorCount &&
        resource.data.conflictCount is int &&
        resource.data.conflictCount == resource.data.contributorCount - resource.data.agreementCount &&
        resource.data.agreementRatio is number &&
        resource.data.agreementRatio >= 0.667 &&
        resource.data.agreementRatio <= 1 &&
        resource.data.agreementRatio * resource.data.contributorCount >=
          resource.data.agreementCount - (0.001 * resource.data.contributorCount) &&
        resource.data.agreementRatio * resource.data.contributorCount <=
          resource.data.agreementCount + (0.001 * resource.data.contributorCount) &&
        resource.data.revision is int &&
        resource.data.revision >= 1 &&
        resource.data.updatedAt is timestamp;
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Users Collection - users can only read/write their own data
    match /users/{userId} {
      allow read, write: if ownsUserDoc(userId);

      // Contributions are private to their owner and written only by the authenticated callable.
      // Excluding this name from the general wildcard keeps a modified client from bypassing the
      // server's rate limit, App Check, and validation.
      match /barcodeContributions/{barcodeId} {
        allow read, delete: if ownsUserDoc(userId);
        allow create, update: if false;
      }

      // Allow the user full access to all subcollections under their own document
      match /{subcollection}/{document=**} {
        allow read, write: if ownsUserDoc(userId) && subcollection != "barcodeContributions";
      }
    }
    
    // Community Hub / Posts Collection
    match /posts/{postId} {
      // Anyone logged in can read posts
      allow read: if signedIn();
      // You can only create a post if you are the author
      allow create: if signedIn() && requestAuthorIsUser();
      // You can only edit or delete a post if you are the original author
      allow update, delete: if signedIn() && resourceAuthorIsUser();
    }
    
    // Groups Collection
    match /groups/{groupId} {
      // Anyone logged in can view groups
      allow read: if signedIn();
      // Signed-in users can create groups they own
      allow create: if signedIn() && requestCreatorIsUser();
      // Only the creator can update the group details
      allow update: if signedIn() && resourceCreatorIsUser();
      allow delete: if signedIn() && resourceCreatorIsUser();
    }
    
    // Group Memberships
    match /groupMemberships/{membershipId} {
      allow read: if signedIn() && resourceMembershipIsUser();
      allow create, update: if validMembershipWrite();
      allow delete: if signedIn() && resourceMembershipIsUser();
    }
    
    // Legacy one-owner barcode pool. Existing documents remain inaccessible during migration.
    match /barcodes/{barcodeId} {
      allow read, write: if false;
    }

    // Server-owned aggregate. Clients may fetch a known barcode only when the private operator
    // config allows reads and the document proves a 3+ contributor, >= 2/3 consensus. Listing the
    // collection and every client write remain forbidden.
    match /communityBarcodeAggregates/{barcodeId} {
      allow get: if signedIn() &&
        communityBarcodeReadsEnabled() &&
        validPublishedBarcodeAggregate(barcodeId);
      allow list, create, update, delete: if false;
    }
  }
}
