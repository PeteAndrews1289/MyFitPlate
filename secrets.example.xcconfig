// Copy this file to secrets.xcconfig and fill in local values.
// Do not commit secrets.xcconfig.

// Use an HTTPS URL before release. Local development can point at your current proxy.
FATSECRET_PROXY_URL = your_proxy_url_here

// Free dedicated key: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY = your_usda_api_key_here
